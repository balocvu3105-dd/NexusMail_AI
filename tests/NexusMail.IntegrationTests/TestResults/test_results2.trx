{"@t":"2026-09-04T09:57:50.7888297Z","@mt":"Failed executing DbCommand ({elapsed}ms) [Parameters=[{parameters}], CommandType='{commandType}', CommandTimeout='{commandTimeout}']{newLine}{commandText}","@l":"Error","@tr":"9032e7652d4a998366503a38e40936cd","@sp":"25d0a203b0e68a83","elapsed":"2","parameters":"@p0='?', @p1='?' (DbType = DateTime), @p2='?' (DbType = DateTime), @p3='?' (DbType = Int32)","commandType":"Text","commandTimeout":30,"newLine":"\r\n","commandText":"UPDATE \"OutboxMessages\"\n              SET \"LockId\" = @p0, \"LockedUntilUtc\" = @p1\n              WHERE \"Id\" IN (\n                  SELECT \"Id\" FROM \"OutboxMessages\"\n                  WHERE \"ProcessedOnUtc\" IS NULL\n                    AND \"DeadLetteredAt\" IS NULL\n                    AND (\"LockedUntilUtc\" IS NULL OR \"LockedUntilUtc\" &lt; @p2)\n                  ORDER BY \"OccurredOnUtc\"\n                  LIMIT @p3\n                  FOR UPDATE SKIP LOCKED\n              )","EventId":{"Id":20102,"Name":"Microsoft.EntityFrameworkCore.Database.Command.CommandError"},"SourceContext":"Microsoft.EntityFrameworkCore.Database.Command","CorrelationId":"a47c8105de464c468632b4336315fb5f","Scope":["a47c8105de464c468632b4336315fb5f"],"Application":"NexusMail"}&#xD;
