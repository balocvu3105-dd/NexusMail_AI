SELECT e."Id", e."AccountId", e."Content", e."LifecycleState", e."MessageId", e."ReceivedAt", e."Sender", e."Subject", a."Id", a."Category", a."ClassificationAttemptId", a."ClassificationError", a."ClassificationStatus", a."Confidence", a."EmailId", a."EmbeddingAttemptId", a."EmbeddingError", a."EmbeddingStatus", a."IsCompletedEventPublished", a."Language", a."Priority", a."PriorityAttemptId", a."PriorityError", a."PriorityScore", a."PriorityStatus", a."Summary", a."SummaryAttemptId", a."SummaryError", a."SummaryStatus", a."Tags", a.xmin&#xD;
FROM "Emails" AS e&#xD;
INNER JOIN "EmailAccounts" AS e0 ON e."AccountId" = e0."Id"&#xD;
LEFT JOIN "AIAnalyses" AS a ON e."Id" = a."EmailId"&#xD;
WHERE e."Id" = @id AND e0."WorkspaceId" = @workspaceId&#xD;
LIMIT 1&#xD;
