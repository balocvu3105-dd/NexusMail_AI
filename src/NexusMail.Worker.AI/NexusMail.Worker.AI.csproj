    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Quartz" Version="3.19.1" />
    <PackageReference Include="Quartz.Extensions.DependencyInjection" Version="3.19.1" />
