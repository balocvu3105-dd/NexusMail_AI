{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=nexusmail;Username=postgres;Password=password",
    "RabbitMq": "amqp://guest:guest@localhost:5672"
  },
  "JwtSettings": {
    "Secret": "SuperSecretKeyForDevelopmentOnlyDoNotUseInProduction12345",
    "Issuer": "NexusMailAI",
    "Audience": "NexusMailAI-Users",
    "ExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "RateLimiting": {
    "LoginLimit": 5,
    "LoginWindowSeconds": 60,
    "RefreshLimit": 10,
    "RefreshWindowSeconds": 60
  }
}
