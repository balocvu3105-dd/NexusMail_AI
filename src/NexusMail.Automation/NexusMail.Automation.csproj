<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      NexusMail.Automation — Automation Rule Engine.
      
      RULE: Independent from NexusMail.Domain.Email.
      Email publishes events → Automation subscribes via Contracts.
      The Rule Engine evaluates conditions and executes actions independently.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NexusMail.Application\NexusMail.Application.csproj" />
    <ProjectReference Include="..\NexusMail.Contracts\NexusMail.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
  </ItemGroup>

</Project>
